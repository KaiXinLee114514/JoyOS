#!/bin/sh
# ============================================================================
#  joyos-run —— 写一行 C,然后立刻在 JoyOS 里跑起来
#
#  用法:
#      bin/joyos-run hello.c          # 编译 → 塞进镜像副本 → 开 QEMU
#      bin/joyos-run HELLO.BIN        # 已经编好了就只做后两步
#      bin/joyos-run hello.c --no-qemu   # 只做镜像,不启动
#
#  它做的事:mkimg 造一张干净镜像 → mkfat 把 README.TXT 和你的程序放进去 →
#  QEMU 开机。窗口里敲 `run HELLO` 就能看见自己写的东西。
# ============================================================================
set -e
SDK=$(cd "$(dirname "$0")/.." && pwd)
ARG="$1"
NOQ=0
[ "$2" = "--no-qemu" ] && NOQ=1
[ -n "$ARG" ] || { echo "用法: joyos-run <源文件.c|程序.BIN> [--no-qemu]"; exit 2; }

case "$ARG" in
    *.c)  BIN="${ARG%.c}.BIN"; "$SDK/bin/joyos-cc" "$ARG" -o "$BIN" ;;
    *)    BIN="$ARG" ;;
esac
NAME=$(basename "$BIN" | tr 'a-z' 'A-Z')

# 内核/stub/字库从仓库的 build/ 拿(自己先 make 一下)
for f in boot.bin stub.bin kernel.bin; do
    [ -f "$SDK/build/$f" ] || { echo "缺少 build/$f —— 先在仓库里 make 一次"; exit 3; }
done
[ -f "$SDK/font/full-joyf.bin" ] || { echo "缺少 font/full-joyf.bin"; exit 3; }

IMG="${TMPDIR:-/tmp}/joyos-$NAME.img"
python3 "$SDK/tools/mkimg.py" "$SDK/build/boot.bin" "$SDK/build/stub.bin" \
        "$SDK/build/kernel.bin" "$IMG" "$SDK/font/full-joyf.bin" >/dev/null
python3 "$SDK/tools/mkfat.py" "$IMG" 6144 8 \
        README.TXT="$SDK/progs/README.TXT" NOTES.TXT="$SDK/progs/NOTES.TXT" \
        "$NAME=$BIN" >/dev/null
echo "✅ 镜像: $IMG"
echo "   开机后敲:  run ${NAME%.BIN}"
[ "$NOQ" = "1" ] && exit 0
exec qemu-system-i386 -drive "file=$IMG,format=raw,if=ide,index=0" -boot c
